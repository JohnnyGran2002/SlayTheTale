    </ui:VisualElement>
    <ui:VisualElement name="CardList" style="flex-grow: 1;">
        <ui:VisualElement name="Header" class="sub-header" style="flex-grow: 0; flex-direction: row; border-bottom-width: 2px; border-left-color: rgb(81, 81, 81); border-right-color: rgb(81, 81, 81); border-top-color: rgb(81, 81, 81); border-bottom-color: rgb(81, 81, 81);">
            <ui:Label text="Card List" class="label" style="flex-grow: 1; -unity-text-auto-size: none; -unity-text-generator: standard; font-size: 18px;"/>
            <ui:Button text="" class="button" style="padding-left: 5px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; justify-content: center; background-color: rgb(88, 88, 88); visibility: hidden;">
                <ui:Image source="project://database/Packages/com.unity.behavior/Blackboard/Assets/Icons/d_CreateAddNew.png?fileID=2800000&amp;guid=e237c32e4a6d6421aa2a9027937857fc&amp;type=3#d_CreateAddNew"/>
