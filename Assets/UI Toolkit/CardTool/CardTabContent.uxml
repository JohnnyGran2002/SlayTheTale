<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/CardTool/AttributeStyles.uss?fileID=7433441132597879392&amp;guid=3f96a9d9bf421e14a97f0501c9a76e4c&amp;type=3#AttributeStyles"/>
    <ui:VisualElement name="CreateCard" style="flex-grow: 1;">
        <ui:VisualElement name="Header" class="sub-header">
            <ui:Label text="Create a card" class="label" style="flex-grow: 1; -unity-text-auto-size: none; -unity-text-generator: standard; font-size: 18px;"/>
            <ui:Button text="" class="button-add button">
                <ui:Image source="project://database/Packages/com.unity.behavior/Blackboard/Assets/Icons/d_CreateAddNew.png?fileID=2800000&amp;guid=e237c32e4a6d6421aa2a9027937857fc&amp;type=3#d_CreateAddNew"/>
