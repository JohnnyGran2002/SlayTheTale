<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/UI%20Toolkit/CardTool/CardToolStyles.uss?fileID=7433441132597879392&amp;guid=3c6455b8042b2e84cb2d53bbe0186765&amp;type=3#CardToolStyles"/>
    <ui:VisualElement name="Container" style="flex-grow: 1; align-items: stretch; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-direction: row; justify-content: space-between; flex-shrink: 1; align-self: auto; flex-wrap: nowrap; visibility: visible; padding-top: 20px; padding-right: 20px; padding-bottom: 40px; padding-left: 20px; align-content: flex-start;">
        <ui:VisualElement name="CardsTab" class="tab" style="flex-grow: 0; width: 25%;">
            <ui:VisualElement name="Header" class="header">
                <ui:Label text="Cards" name="Label" class="label"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="CenterContainer" class="tab" style="width: 50%; justify-content: center; align-items: stretch; align-content: flex-start; height: 100%; min-width: auto; min-height: auto; flex-grow: 1;">
            <ui:TabView style="flex-grow: 1; flex-direction: column; width: 100%; font-size: 24px; -unity-font-style: bold; align-items: flex-start; justify-content: flex-start; height: 100%; align-content: auto; align-self: auto;">
                <ui:Tab label="Card view" name="CardTab" style="align-items: center; justify-content: center; align-self: auto; align-content: auto; flex-direction: column; flex-grow: 1; height: 100%; width: 100%;">
                    <ui:VisualElement name="CardView" style="align-items: center; justify-content: center; align-self: center; flex-grow: 0; align-content: auto; flex-direction: column; width: 100%; height: 100%;"/>
                </ui:Tab>
                <ui:Tab label="Scene view&#10;" name="SceneTab" style="width: 100%; height: 100%; flex-grow: 1; align-items: center; justify-content: center; align-self: auto;">
                    <ui:VisualElement name="SceneView" style="flex-grow: 0; aspect-ratio: auto; justify-content: center; align-self: center; width: 100%; height: 100%; padding-top: 10px; padding-bottom: 10px; padding-left: 5px; padding-right: 5px;"/>
                </ui:Tab>
            </ui:TabView>
        </ui:VisualElement>
        <ui:VisualElement name="CardAttributes" class="tab" style="width: 25%;">
            <ui:VisualElement name="Header" class="header">
                <ui:Label text="Attributes" class="label" style="font-size: 24px; -unity-text-align: middle-left; flex-shrink: 1; flex-direction: row; flex-grow: 1; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); -unity-font-style: bold; letter-spacing: 0; word-spacing: 0; padding-left: 5px;"/>
            </ui:VisualElement>
            <ui:ScrollView name="ScrollView_Details"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
