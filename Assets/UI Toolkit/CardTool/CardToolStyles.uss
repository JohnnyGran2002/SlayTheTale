:root {
    width: 100%;
    height: 100%;
}

.tab {
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-left-color: rgb(81, 81, 81);
    border-right-color: rgb(81, 81, 81);
    border-top-color: rgb(81, 81, 81);
    border-bottom-color: rgb(81, 81, 81);
    background-color: rgb(47, 47, 47);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    height: 100%;
    width: 25%;
}

.header {
    margin-top: 6px;
    margin-right: 6px;
    margin-bottom: 6px;
    margin-left: 6px;
    flex-direction: row;
    background-color: rgb(32, 32, 32);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    padding-top: 0;
    padding-right: 5px;
    padding-bottom: 0;
    padding-left: 5px;
    min-height: 50px;
    max-height: 50px;
}

.button {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    margin-top: 6px;
    margin-right: 6px;
    margin-bottom: 6px;
    margin-left: 6px;
    background-color: rgb(81, 81, 81);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 20px;
}

.container {
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    background-color: rgb(166, 166, 166);
    flex-grow: 1;
}

.cardRow {
}

.tabviewTab {
}

.unity-tab-view__content-container {
    height: 100%;
    width: 100%;
    justify-content: center;
    align-items: center;
}

.unity-tab__content-container {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}



.label {
    flex-shrink: 1;
    flex-direction: row;
    flex-grow: 1;
    padding-left: 5px;
    color: rgb(229, 229, 229);
    -unity-text-auto-size: none;
    -unity-text-generator: standard;
    -unity-font-style: bold;
    font-size: 24px;
    -unity-text-align: middle-left;
    -unity-font-definition: url("project://database/Library/unity%20default%20resources?fileID=10102&guid=0000000000000000e000000000000000&type=0#LegacyRuntime");
}
