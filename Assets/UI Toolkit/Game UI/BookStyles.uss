:root {
}

.cardSlot {
    flex-grow: 0;
    width: 140px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    transition-property: scale;
    transition-duration: 0.15s;
    scale: 1;
    align-items: center;
    justify-content: center;
    overflow: visible;
    height: 196px;
    flex-direction: column;
    align-self: stretch;
    align-content: flex-start;
}

.selectedCard {
    scale: 1.8;
    aspect-ratio: 0.7;
}



.cardSlot-page {
    flex-grow: 0;
    flex-direction: row;
    justify-content: space-evenly;
    flex-wrap: wrap;
    align-self: auto;
    align-content: center;
    align-items: stretch;
    margin-right: 0;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-right: 5px;
    padding-left: 5px;
}
